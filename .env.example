# Clerk — https://dashboard.clerk.com
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Supabase — https://supabase.com/dashboard
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# AI — OpenRouter (https://openrouter.ai/keys)
OPENROUTER_API_KEY=
# Optional: override the default model (defaults to anthropic/claude-sonnet-4)
# Other examples: openai/gpt-4o, openai/gpt-4o-mini, google/gemini-2.5-flash
# OPENROUTER_MODEL=

# Legacy fallback — only used if you flip lib/ai/index.ts back to gemini provider
# GEMINI_API_KEY=

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
